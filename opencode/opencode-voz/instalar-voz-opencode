#!/usr/bin/env zsh
# Instala/configura la voz para opencode (edge-tts + speak + ocv)

set -e

BIN="$HOME/.local/bin"
mkdir -p "$BIN"

# 1. edge-tts
if ! command -v edge-tts &>/dev/null; then
    echo "Instalando edge-tts..."
    pipx install edge-tts
else
    echo "edge-tts ya instalado"
fi

# 2. Script speak (copiar desde la carpeta del proyecto)
SCRIPT_DIR="${0:A:h}"
SPEAK_SRC="$SCRIPT_DIR/speak"
echo "Instalando speak..."
if [ -f "$SPEAK_SRC" ]; then
    cp "$SPEAK_SRC" "$BIN/speak"
    chmod +x "$BIN/speak"
    echo "  → $BIN/speak (copiado desde $SPEAK_SRC)"
else
    echo "  ⚠ No se encontró $SPEAK_SRC, saltando"
fi

# 3. Añadir función ocv a .zshrc si no existe ya
ZSHRC="$HOME/.zshrc"
if grep -q 'function ocv()' "$ZSHRC" 2>/dev/null; then
    echo "Función ocv ya existe en .zshrc"
else
    echo "" >> "$ZSHRC"
    echo "# opencode con TUI completo + voz" >> "$ZSHRC"
    echo 'function ocv() {' >> "$ZSHRC"
    echo '    script -q -f -c "opencode $*" /dev/null 2>&1 | tee >("$HOME/.local/bin/speak")' >> "$ZSHRC"
    echo '}' >> "$ZSHRC"
    echo "  → añadida función ocv a .zshrc"
fi

# 4. Asegurar PATH
if ! grep -q 'HOME/.local/bin' "$ZSHRC" 2>/dev/null; then
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$ZSHRC"
    echo "  → añadido PATH a .zshrc"
fi

echo ""
echo "✅ Instalación completada."
echo "Reinicia la terminal o ejecuta: source ~/.zshrc"
echo "Luego usa: ocv"
