{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "prompt": "{file:./prompts/read-agents.txt}"
    },
    "plan": {
      "prompt": "{file:./prompts/read-agents.txt}"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "model": "llama3.1:8b",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "ollama"
      },
      "models": {
        "llama3.1:8b": {
          "name": "llama3.1:8b",
          "options": {
            "num_ctx": 32768
          },
          "maxTokens": 8192
        },
        "gemma4:e4b": {
          "name": "gemma4:e4b",
          "options": {
            "num_ctx": 32768
          },
          "maxTokens": 8192
        },
        "qwen3.5:9b": {
          "name": "qwen3.5:9b",
          "options": {
            "num_ctx": 32768
          },
          "maxTokens": 16384
        },
        "qwen3.5:9b-32k": {
          "name": "qwen3.5:9b-32k",
          "options": {
            "num_ctx": 32768
          },
          "maxTokens": 16384
        },
        "pdurugyan/qwen3.5-9b-deepseek-v4-flash-Q4_K_M-v_2:latest": {
          "name": "pdurugyan/qwen3.5-9b-deepseek-v4-flash-Q4_K_M-v_2:latest",
          "options": {
            "num_ctx": 32768
          },
          "maxTokens": 16384
        },
        "deepseek-r1:8b": {
          "name": "deepseek-r1:8b",
          "options": {
            "num_ctx": 32768
          },
          "maxTokens": 16384
        },
        "deepseek-v4-flash-stock:latest": {
          "name": "deepseek-v4-flash-stock:latest",
          "options": {
            "num_ctx": 32768
          },
          "maxTokens": 16384
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/home/antonio"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": ["mcp-fetch-server"],
      "enabled": true
    },
    "sequential_thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
"duckduckgo_search": {
  "type": "local",
  "command": ["duckduckgo-mcp-server"],
  "enabled": false
}
  }
}
