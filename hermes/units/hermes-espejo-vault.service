[Unit]
Description=Refresca las notas del vault de Obsidian desde los markdown de configuracion de Hermes
Documentation=file:%h/Config/hermes/AGENTS.md
After=default.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/Config/hermes/espejo-vault.sh
