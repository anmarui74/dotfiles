+            stop_playback()
+            if _done is not None:
+                _done.set()
+            # El log va al final y aislado: si el import fallara no debe impedir el corte.
+            try:
+                from cli import logger
+                logger.info("TTS CUT: %s", motivo)
+            except Exception:
+                pass
+        except Exception:
+            pass
