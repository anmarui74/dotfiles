+    def _tui_cut_tts(self, motivo: str) -> None:
+        """Corta la reproducción de audio en curso (interrupción explícita del usuario).
+
+        ``stop_playback()`` termina el reproductor (subproceso o ``sounddevice``) y el evento de
+        parada drena la tubería de streaming; ``mark_speech_interrupted`` evita que una respuesta
+        obsoleta se retome después. Solo actúa si hay algo sonando, para que la tecla no tenga
+        efectos colaterales cuando no se está reproduciendo nada.
+        """
+        try:
+            from tools.voice_mode import is_audio_output_active, stop_playback
+            _done = getattr(self, "_voice_tts_done", None)
