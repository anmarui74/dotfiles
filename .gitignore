# Nunca versionar credenciales ni backups en el repo de dotfiles.
# La copia saneada se genera con ~/Config/opencode/backup-opencode.sh y
# ~/Config/mimocode/backup-mimocode.sh, que ya los excluyen del volcado;
# esto es la SEGUNDA barrera por si alguien hace `git add -A`.
**/*.env
**/auth.json
**/service.json
**/credenciales/
**/backups/**/*.tar.gz
**/mcp-memory-backup-*.jsonl
**/mimocode-memory-backup-*.jsonl
